@startuml
!include globals/stylesheets.iuml


participant ":GameController" as gc
participant ":GameService" as gs
participant "game:Game" as game
participant "round:Round" as round
participant ":EvaluationService" as ev
participant ":EntityService" as ges
participant ":GameRepository" as gr

gc -> gs: selectProposition(roundId,playerId,propositionId)
gs -> ges: editGame(gameId)
activate ges
ges -> gr : findById(gameId)
gr  --> ges: Game
ges --> gs
gs -> game: getCurrentRound()
game -> round: getState()
round --> game: Round state
round -> ev :evaluateSelection(round, propositionId, selectorId)
ev --> round : Evaluation
game --> gs: Round
gs -> game : updateResults(result: Result)
game --> gs
ges -> gr : save(game)
gr --> ges
ges --> gs
gs --> gc


@enduml