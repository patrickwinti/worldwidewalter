@startuml
skinparam ranksep 100

skinparam object {
    BackgroundColor White
    ArrowColor Firebrick
    BorderThickness 2
}

skinparam roundcorner 0

hide empty members

object Player
object Game
object Turn
object Round
object Prompt
object Proposition
object GameState
together{
    object WaitingForPlayers
    object WaitingForPropositions
    object WaitingForSelections
}

Player : name
Player : ID
Game : ID
Prompt : text
Proposition : text


Prompt "1"-l-"1..*" Proposition : < completes
Game "1"-d-"*" Player : < participates
Game "1"*--"*" Turn
Turn "1"*-r-"1..3" Round
Round  -- Game : updates points >
Round "1"-d-"1" Prompt : presents >
Player "1"-r-"1" Turn: < has Sphinx
Player "1"--"1" Proposition : submits >
Player "1"--"1" Proposition : selects (if not Sphinx) >
WaitingForPlayers -d-|> GameState
WaitingForPropositions -d-|> GameState
WaitingForSelections -d-|> GameState
GameState "1"-l-"*" Game : < is in

@enduml
