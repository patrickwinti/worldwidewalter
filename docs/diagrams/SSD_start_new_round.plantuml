@startuml
!include globals/stylesheets.iuml


actor "Player" as p
participant ":GameController" as gc
participant ":GameService" as gs
participant ":RoundService" as rs
participant ":GameProperties" as gp
participant "game:Game" as game
participant "round:Round" as round
participant ":EntityService" as ges
participant ":GameRepository" as gr

p -> gc : request enter round
gc -> gs: enterRound(gameId, playerId)
gs -> ges: editGame(gameId)
activate ges
ges -> gr : findById(gameId)
gr  --> ges: Game
ges --> gs
gs -> game: needsNewRound()
game -> round: isFinished()
round --> game: true if round\ntimers rund out
game --> gs: true round is finished or all players submitted their selections
gs -> game: hasCapacityForNewActivePlayer()
game --> gs: true if less than maximum active players
gs -> game: hasPlayer(playerId)
game --> gs: true if player is in the game
gs -> rs :createNewRound(game)
rs -> gp : getPropositionSubmissionDuration
gp --> rs: proposition submission duration
rs -> gp : getRoundEnterLimitDuration
gp --> rs: round enter limit duration
rs -> gp : getSelectionSubmissionDuration
gp --> rs: selection submission duration

rs --> gs : new round
gs -> game :addRound(round)
game --> gs
gs -> game : moveToActivePlayers(playerId)
game --> gs
ges -> gr : save(game)
gr --> ges
ges --> gs
gs --> gc

gc --> p : enter round response

@enduml