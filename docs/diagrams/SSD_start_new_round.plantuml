@startuml
skinparam sequence {
    BackgroundColor white
    BorderColor Black
    ArrowColor Firebrick
    BorderThickness 2
    LifeLineBackgroundColor #FFD966
}
skinparam Note{
    BorderColor #FFD966
    BackgroundColor #FFD966
}
skinparam participant {
    BackgroundColor white
    BorderThickness 2
}
skinparam responseMessageBelowArrow true
skinparam style strictuml

participant ":GameController" as gc
participant ":GameService" as gs
participant ":RoundService" as rs
participant "game:Game" as game
participant "round:Round" as round
participant ":EntityService" as ges
participant ":GameRepository" as gr

gc -> gs: enterRound(gameId, playerId)
gs -> ges: editGame(gameId)
activate ges
ges -> gr : findGame(gameId)
gr  --> ges: Game
ges --> gs
gs -> game: getState()
game -> round: getState()
round --> game: Round state
game --> gs: Game state
gs -> game: hasCapacityForNewActivePlayer()
game --> gs: true or false depending on nr of players
game -> gs: hasPlayer(playerId)
gs -> rs :createNewRound(game)
rs -> game :addRound(round)
game --> rs
rs -->gs
gs -> game : moveToActivePlayers
game --> gs
gs-->ges
ges -> gr : save(game)
gr --> ges
ges --> gs
gs --> gc
@enduml