@startuml
!include globals/stylesheets.iuml


skinparam linetype ortho
left to right direction

'Actors and use cases
actor Player as p
actor Sphinx as s
p<|-right-- s

package WorldwideWalter {
  usecase "Start game" as UC1
  usecase "Join game" as UC2
  usecase "Play round" as UC3
  usecase "Choose prompt" as UC5
}

'Relationships
p -- UC1
p -- UC2
p -- UC3
s -- UC5
@enduml