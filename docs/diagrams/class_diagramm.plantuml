@startuml
package backend{
    hide empty members
    class GameController {
        -gameService: GameService
        +createGame(): GameDto
        +getGame(gameId: String) : GameDto
        +enterGame(gameId: String, playerDto: PlayerJoinRequestDto) : PlayerDto
        +leaveGame(gameId: String, playerId: String) : void
        +submitProposition(roundId: String, playerId: String, proposition: PropositionSubmissionDto) : void
        +selectProposition(roundId: String, propositionId: String, playerId: String) : void
        +startNextRound(gameId: String) : RoundDto
    }
    class GameDto {
        -id: String
        -state: State
    }
    class Game {
        id: String
        waitingRoom: Map<Player>
        activePlayers: Map<Player>
    }
    interface GameService{
       §createGame(): Game
       §leaveGame(gameId: String, playerId: String): void
       §submitProposition(roundId: String, playerId: String, gaps: List<String>): void
       §selectProposition(roundId: String, playerId: String, propositionId: String): void
       §getGame(gameId: String) : Game
       §enterGame(gameId: String, playerName: String) : Player
       §startNextRound(gameId: String) : Round
    }
    interface GameRepository
    class PlayerDto {
        -id: String
    }
    class PlayerJoinRequestDto {
        -playerName:String
    }
    class PropositionSubmissionDto {
        -gaps: List<String>
    }
    class RoundDto {
        -id: String
        -prompt: String
    }
    class Player {
        -id: String
    }
    class Turn {
        -id: String
        -player: Player
        -round: Rounds[]
    }
    class Round {
        -id: String
        -prompt: Prompt
        -propositions: Map<Proposition>
        -selections: Map<Selection>
    }
    exception GameError {
        FullCapacityException
        NotEnoughPlayersException
        NotFoundException
    }
    exception RoundError {
        OngoingException
        NotFoundException
    }
    exception PropositionError {
        NotFoundException
    }
    exception PlayerError {
        NotFoundException
    }

    GameController..>PlayerDto
    GameController..>PlayerJoinRequestDto
    GameController..>PropositionSubmissionDto
    GameController..>RoundDto
    GameController ..> GameDto

    GameService ..> Game
    GameService ..> Round
    GameService ..> Player
    GameService ..> GameError
    GameService ..> RoundError
    GameService ..> PlayerError
    GameService ..> PropositionError
    GameService --> GameRepository
}
@enduml