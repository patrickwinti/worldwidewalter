pipeline {
    agent any

    tools {
        maven "M3"
    }

    stages {
        stage('Build') {
            steps {
                sh 'java -version'
                // Get some code from a GitHub repository
                git branch: 'feature/WWW-88-set-up-deployment',
                    credentialsId: 'zhaw',
                    url: 'https://github.zhaw.ch/PM3-FS23-IT21ta-ZH-Team4/PM3_FS23_IT21ta-ZH-Team4'

                // Run Maven on a Unix agent.
                sh "mvn -Dmaven.test.failure.ignore=true clean package"

            }

            post {
                // If Maven was able to run the tests, even if some of the test
                // failed, record the test results and archive the jar file.
                success {
                    archiveArtifacts 'backend/target/*.jar'
                    sshagent(credentials : ['hostCredentials']) {
                      sh "echo pwd"
                      sh 'ssh -t -t patrick@192.168.1.51 -o StrictHostKeyChecking=no "echo pwd && /home/patrick/www/run-www.sh"'
                    }
                }

            }
        }
    }
}
