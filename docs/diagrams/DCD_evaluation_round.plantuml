@startuml
skinparam class {
    BackgroundColor white
    ArrowColor Firebrick
    BorderThickness 2
}
skinparam roundcorner 0
skinparam packagestyle Frame
hide empty members

interface GameService {
    +selectProposition(roundId:String,  playerId:String,  propositionId:String)
}

interface EntityService {
    +editRound(roundId: String, editor: Consumer)
}

interface RoundEvaluator {
    +eval(round: Round, propositionId: String): Evaluation
}

class Game {
    -rounds: List<Round>
    +getState()
    +getCurrentRound()
    +updateResults(result: Result)
}

class Round {
    +getState()
}

interface GameRepository{
 +findById(id:String)
 +save(game:Game)
}

class GameController {
    +evalRound(game: Game, playerId: String, propositionId: String): Evaluation
}


GameController "1"-->"1" GameService
GameService "1"-->"1" EntityService
GameService "1"-->"1" RoundEvaluator
GameService "1"..>"*" Game
EntityService "1"-->"1" GameRepository
Game "1"-->"*" Round


@enduml