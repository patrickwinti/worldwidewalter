pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven "M3"
    }

    stages {
        stage('Build') {
            steps {
                sh 'java -version'
                sh "mvn -Dmaven.test.failure.ignore=true clean package"
            }

            post {
                success {
                    archiveArtifacts '**/target/*.jar'
                    sh 'sudo /usr/bin/docker-compose down'
                    sh 'sudo /usr/bin/docker-compose --build -d'
                }
            }
        }
    }
}
