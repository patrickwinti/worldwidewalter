@startuml
skinparam sequence {
    BackgroundColor white
    BorderColor Black
    ArrowColor Firebrick
    BorderThickness 2
    LifeLineBackgroundColor #FFD966

}
skinparam Note{
    BorderColor #FFD966
    BackgroundColor #FFD966
}
skinparam participant {
    BackgroundColor white
    BorderThickness 2
}
skinparam responseMessageBelowArrow true
skinparam style strictuml

participant ":GameController" as gc
participant ":RoundService" as rs
participant "game:Game" as game
participant "round:Round" as round
participant ":EntityService" as ges
participant ":GameRepository" as gr

gc -> rs: submitProposition(roundId, playerId, gaps)
rs->ges: isPlayerActiveInRound(roundId, playerId)
ges-->rs: true if player active for game
rs -> ges: editRound(roundId)
activate ges
ges -> gr : findAll()
gr  --> ges: List<Game>
ges --> rs: editable round
rs -> round: addProposition(proposition)
note left
Only if proposition
is not a duplicate
end note
round-->rs
ges -> gr : save(game)
gr --> ges
ges --> rs
rs --> gc


@enduml