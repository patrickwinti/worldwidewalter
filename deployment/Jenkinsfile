pipeline {
    agent any

    tools {
        maven "M3"
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'which branch should be built')
    }

    stages {
        stage('Build') {
            steps {
                sh 'java -version'
                // Get code from a GitHub repository
                git branch: "${params.BRANCH}",
                    credentialsId: 'zhaw',
                    url: 'https://github.zhaw.ch/PM3-FS23-IT21ta-ZH-Team4/PM3_FS23_IT21ta-ZH-Team4'

                // Run Maven on a Unix agent.
//                 sh "mvn -P prod -Dmaven.test.failure.ignore=true clean package"
                sh "mvn -P prod -DskipTests=true clean package"
            }

            post {
                // If Maven was able to run the tests, even if some of the test
                // failed, record the test results and archive the jar file.
                success {
                    archiveArtifacts 'backend/target/*.jar'

                    // call script on host to stop old jar and copy & run new artifact
//                     sshagent(credentials : ['hostCredentials']) {
//                       sh "echo pwd"
//                       sh 'ssh -t -t patrick@192.168.1.51 -o StrictHostKeyChecking=no "echo pwd && /home/patrick/www/run-www.sh"'
//                     }
                }

            }
        }
    }
}
