@startuml
skinparam class {
    BackgroundColor white
    ArrowColor Firebrick
    BorderThickness 2
}
skinparam roundcorner 0
skinparam packagestyle Frame
hide empty members

interface GameService {
    +selectProposition(roundId:String,  playerId:String,  propositionId:String)
}

interface EntityService {
    +editGameForRound(roundId: String, UnaryOperator<Game>)
}

interface EvaluationService {
    +eval(round: Round): Evaluation
}

class Game {
    -rounds: List<Round>
    +getState()
    +getCurrentRound()
    +updateResults(result: Result)
}

class Round {
    +getState()
}

class GameRepository {
    +findAll(): List<Game>
}

class GameController {
    +evalRound(game: Game): Evaluation
}


GameController ..> GameService
GameService ..> EntityService
GameService ..> EvalService
GameService ..> Game
EntityService ..> GameRepository
Game..> Round


@enduml