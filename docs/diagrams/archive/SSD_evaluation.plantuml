@startuml
!include globals/stylesheets.iuml


participant ":GameController" as gc
participant ":RoundService" as rs
participant "game:Game" as game
participant "round:Round" as round
participant ":EvaluationService" as ev
participant ":EntityService" as ges
participant ":GameRepository" as gr

gc -> rs: selectProposition(roundId,playerId,propositionId)
rs -> ges: editRound(roundId)
activate ges
ges -> gr : findById(roundId)
gr  --> ges: Game
ges --> rs
rs -> round: addSelection(playerId, propositionId)
round --> rs:
rs -> ev :evaluateSelection(round, propositionId, selectorId)
ev --> rs : result
rs -> game : addPoints(result: Result)
game --> rs
ges -> gr : save(game)
gr --> ges
ges --> rs
rs --> gc


@enduml